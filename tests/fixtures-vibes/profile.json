{
  "runtime": "vibes-python",
  "version": "9a34046d31d4d6d0cc6ccc666aa891d4e2ed5de0",
  "lifecycle": {
    "prepare": "mkdir -p \"$FIXTURES_ROOT/pi\" \"$FIXTURES_ROOT/ws\" && printf '{\"providers\":{\"fixture\":{\"baseUrl\":\"%s\",\"api\":\"openai-completions\",\"apiKey\":\"fixture-local-only\",\"models\":[{\"id\":\"fixture-1\"},{\"id\":\"fixture-2\"}]}}}' \"$FIXTURE_MODEL_URL\" > \"$FIXTURES_ROOT/pi/models.json\"",
    "start": "REPO=\"$(cd ../.. && pwd)\" && PY=\"${VIBES_PYTHON:-$REPO/.venv/bin/python}\" && cd \"$FIXTURES_ROOT/ws\" && PYTHONPATH=$REPO/src PI_CODING_AGENT_DIR=\"$FIXTURES_ROOT/pi\" VIBES_HOST=127.0.0.1 VIBES_PORT=$FIXTURES_PORT VIBES_DB_PATH=\"$FIXTURES_ROOT/vibes.db\" VIBES_DEFAULT_AGENT=pi VIBES_PI_ENABLED=true VIBES_PI_MODEL=fixture/fixture-1 exec \"$PY\" -m vibes.app"
  },
  "readiness": {
    "path": "/health",
    "status": 200,
    "timeoutMs": 60000
  },
  "session": {
    "create": {
      "method": "POST",
      "path": "/sessions",
      "body": { "name": "{name}" },
      "idField": "session.id"
    },
    "open": "/?session_id={id}"
  },
  "auth": {
    "mode": "none"
  },
  "capabilities": [
    "@cap-queue",
    "@cap-steer",
    "@cap-stop",
    "@cap-attachments",
    "@cap-model-picker",
    "@cap-thinking-levels",
    "@cap-quick-actions",
    "@cap-slash-commands",
    "@cap-compaction",
    "@cap-context-meter",
    "@cap-thoughts",
    "@cap-tool-output",
    "@cap-message-delete",
    "@cap-messages-tool",
    "@cap-read-aloud",
    "@cap-svg-render",
    "@cap-reconnect",
    "@cap-session-picker",
    "@cap-session-manage",
    "@cap-plan-sidebar",
    "@cap-workspace",
    "@cap-workspace-write",
    "@cap-editor",
    "@cap-terminal",
    "@cap-system-meters",
    "@cap-skills",
    "@cap-search",
    "@cap-pwa",
    "@cap-theme-tint"
  ],
  "tools": {
    "openFile": "open_file"
  },
  "skips": "skips.json"
}
