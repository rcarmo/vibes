# GitHub Linguist metadata
#
# Vibes is a Python application with checked-in generated frontend bundles,
# third-party browser assets, and JavaScript-heavy acceptance fixtures. Keep
# maintained frontend source detectable as JavaScript, but do not let generated,
# vendored, documentation, or test-only artifacts determine repository language.

# Generated frontend output.

# Vendored Piclaw/common assets and browser libraries.

# Test and parity fixtures are not production implementation languages.
tests/**/*.mjs linguist-detectable=false
# Preserve the byte-identical canonical UX fixture on Windows checkouts.
tests/ux/features/canonical-ux.feature text eol=lf
# Bun emits meaningful multiline template literals; do not rewrite their whitespace.

# Documentation media.
docs/demo.gif linguist-documentation=true
